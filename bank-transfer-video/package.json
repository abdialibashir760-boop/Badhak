{
  "name": "bank-transfer-video",
  "version": "1.0.0",
  "private": true,
  "description": "10-second 16:9 animated explainer: how money moves between banks (Remotion, SVG + CSS only)",
  "scripts": {
    "start": "remotion studio",
    "preview": "remotion studio",
    "render": "remotion render src/index.ts BankTransfer out/bank-transfer.mp4 --crf=16",
