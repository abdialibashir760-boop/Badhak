{
  "name": "rome-documentary",
  "version": "1.0.0",
  "private": true,
  "description": "How Rome Became the Most Powerful Empire in the Ancient World — 4-minute Remotion documentary",
  "scripts": {
    "studio": "remotion studio",
    "timeline": "node --experimental-strip-types tools/build-timeline.ts",
    "render": "remotion render Documentary out/rome-documentary.mp4 --codec=h264 --crf=18 --concurrency=4",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  }
}
