// Builds the master timeline: narration sentence times (from the TTS output) → shot times. Writes
//   src/data/timeline.generated.ts  (for Remotion)   and   audio/timeline.json  (for the audio mixer).
import fs from 'node:fs';
import { SHOTS } from '../src/data/shots.ts';
const FPS = 30, INTRO = 1.2, GAP = 0.3, SECTION_GAP = 0.6, OUTRO = 5.0;
const voice = JSON.parse(fs.readFileSync(new URL('../audio/voice/sentences.json', import.meta.url), 'utf8'));
let t = INTRO, prev = '';
const sentences = voice.sentences.map((s: any) => {
  if (prev && s.section !== prev) t += SECTION_GAP; prev = s.section;
  const row = { id: s.id, section: s.section, text: s.text, start: +t.toFixed(3), dur: s.seconds, end: +(t + s.seconds + GAP).toFixed(3) }; t = row.end; return row;
});
const byId = Object.fromEntries(sentences.map((s: any) => [s.id, s]));
const speechEnd = t, total = Math.ceil((speechEnd + OUTRO) * FPS) / FPS;
// group consecutive shots with identical (from,to) and split their window by weight
const shots: any[] = []; let i = 0;
while (i < SHOTS.length) {
  const key = (s: any) => `${s.from}|${s.to ?? s.from}`; let j = i; while (j < SHOTS.length && key(SHOTS[j]) === key(SHOTS[i])) j++;
  const grp = SHOTS.slice(i, j), a = byId[grp[0].from].start, b = byId[grp[0].to ?? grp[0].from].end, W = grp.reduce((n, g) => n + (g.w ?? 1), 0); let cur = a;
  for (const g of grp) { const d = ((b - a) * (g.w ?? 1)) / W; shots.push({ ...g, start: +cur.toFixed(3), dur: +d.toFixed(3) }); cur += d; }
  i = j;
}
// close any gaps between groups (e.g. section gaps / intro): each shot runs until the next one starts
shots[0].start = 0;
for (let k = 0; k < shots.length - 1; k++) shots[k].dur = +(shots[k + 1].start - shots[k].start).toFixed(3);
shots[shots.length - 1].dur = +(total - shots[shots.length - 1].start).toFixed(3);
shots.forEach((s, k) => { s.i = k; s.id = 's' + String(k + 1).padStart(2, '0'); });
const out = { fps: FPS, total, totalFrames: Math.round(total * FPS), sentences, shots };
fs.writeFileSync(new URL('../audio/timeline.json', import.meta.url), JSON.stringify(out, null, 1));
fs.writeFileSync(new URL('../src/data/timeline.generated.ts', import.meta.url), `// GENERATED by tools/build-timeline.mts\nexport const TIMELINE = ${JSON.stringify(out)} as const;\n`);
console.log(`${shots.length} shots · ${sentences.length} sentences · ${total.toFixed(1)} s (${Math.floor(total / 60)}:${String(Math.round(total % 60)).padStart(2, '0')}) · ${out.totalFrames} frames`);
for (const s of shots) console.log(s.id, s.start.toFixed(1).padStart(6), s.dur.toFixed(1).padStart(5), s.kind.padEnd(4), s.scene);
