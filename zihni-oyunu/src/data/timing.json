{
 "fps": 30,
 "totalSeconds": 355.09328199999976,
 "totalFrames": 10653,
 "sentences": [
  {
   "i": 0,
   "text": "Biri senden bir iyilik istiyor.",
   "start": 3.2,
   "end": 4.94
  },
  {
   "i": 1,
   "text": "Yapmak istemiyorsun.",
   "start": 5.36,
   "end": 6.575
  },
  {
   "i": 2,
   "text": "Yorgunsun.",
   "start": 6.995,
   "end": 7.676
  },
  {
   "i": 3,
   "text": "Kendi sorunların var.",
   "start": 8.096,
   "end": 9.297
  },
  {
   "i": 4,
   "text": "Ama daha düşünmene fırsat kalmadan ağzından şu çıkıyor: ‘Tabii.’",
   "start": 9.717,
   "end": 13.317
  },
  {
   "i": 5,
   "text": "Ve kabul ettiğin an, tuhaf bir şey hissediyorsun.",
   "start": 13.737,
   "end": 16.345
  },
  {
   "i": 6,
   "text": "Mutluluk değil.",
   "start": 17.065,
   "end": 17.779
  },
  {
   "i": 7,
   "text": "Rahatlama.",
   "start": 18.699,
   "end": 19.325
  },
  {
   "i": 8,
   "text": "Çünkü birkaç saniyeliğine, onları hayal kırıklığına uğratmadığını biliyorsun.",
   "start": 20.095,
   "end": 24.259
  },
  {
   "i": 9,
   "text": "Peki ya kaçınmaya çalıştığın şey birini hayal kırıklığına uğratmak değil de, sonrasında hissettiğin duyguysa?",
   "start": 24.679,
   "end": 30.409
  },
  {
   "i": 10,
   "text": "Bu hissi muhtemelen tanıyorsun.",
   "start": 34.229,
   "end": 36.024
  },
  {
   "i": 11,
   "text": "Bir iş arkadaşın vardiyasına bakmanı istiyor.",
   "start": 36.444,
   "end": 38.983
  },
  {
   "i": 12,
   "text": "Bitkinsin ama kabul ediyorsun.",
   "start": 39.403,
   "end": 41.173
  },
  {
   "i": 13,
   "text": "Bir arkadaşın, tek başına kalmaya çok ihtiyacın olduğu bir anda arıyor ve sen açıyorsun.",
   "start": 41.593,
   "end": 46.377
  },
  {
   "i": 14,
   "text": "Biri seni kıran bir espri yapıyor ve hiçbir şey söylemek yerine sen de gülüyorsun.",
   "start": 46.797,
   "end": 51.145
  },
  {
   "i": 15,
   "text": "Sonra, yalnız kaldığında, o anı zihninde tekrar tekrar oynatıyorsun.",
   "start": 51.565,
   "end": 55.675
  },
  {
   "i": 16,
   "text": "Ne söylemen gerektiğini düşünüyorsun.",
   "start": 56.095,
   "end": 58.107
  },
  {
   "i": 17,
   "text": "Kendine kızıyorsun.",
   "start": 58.527,
   "end": 59.613
  },
  {
   "i": 18,
   "text": "Ve bir dahaki sefer aynı şey olduğunda, yine aynısını yapıyorsun.",
   "start": 60.033,
   "end": 63.625
  },
  {
   "i": 19,
   "text": "Neden?",
   "start": 64.645,
   "end": 65.038
  },
  {
   "i": 20,
   "text": "Bazı insanlar için başkalarını memnun etmek, reddedilme, çatışma ya da onaylanmama korkusunu yönetmenin bir yoluna dönüşür.",
   "start": 66.158,
   "end": 72.96
  },
  {
   "i": 21,
   "text": "Zihin bir örüntü öğrenir.",
   "start": 73.38,
   "end": 74.837
  },
  {
   "i": 22,
   "text": "Kabul edersem, belki üzülmezler.",
   "start": 75.257,
   "end": 77.335
  },
  {
   "i": 23,
   "text": "Yardım edersem, belki bana yine de ihtiyaç duyarlar.",
   "start": 77.755,
   "end": 80.868
  },
  {
   "i": 24,
   "text": "Hiçbir şeyi zorlaştırmazsam, belki bu ilişkiyi kaybetmem.",
   "start": 81.288,
   "end": 84.614
  },
  {
   "i": 25,
   "text": "Ve karşındaki gülümsediğinde rahatlıyorsun.",
   "start": 85.034,
   "end": 87.415
  },
  {
   "i": 26,
   "text": "Bu rahatlama davranışı pekiştirebilir.",
   "start": 87.835,
   "end": 89.868
  },
  {
   "i": 27,
   "text": "Rahatsızlık ortaya çıktığında onay arayışına yöneliyorsun.",
   "start": 90.288,
   "end": 93.268
  },
  {
   "i": 28,
   "text": "Zamanla, bir şeyi gerçekten isteyip istemediğini sormayı bırakabilirsin.",
   "start": 93.688,
   "end": 97.406
  },
  {
   "i": 29,
   "text": "Bunun yerine kendine, herkesi neyin mutlu edeceğini soruyorsun.",
   "start": 97.826,
   "end": 101.182
  },
  {
   "i": 30,
   "text": "Her onaylayan bakışın küçük bir ışık yarattığını hayal et.",
   "start": 102.202,
   "end": 105.178
  },
  {
   "i": 31,
   "text": "O ışıkların peşinden koşmaya başlıyorsun.",
   "start": 105.598,
   "end": 107.979
  },
  {
   "i": 32,
   "text": "Biri gülümsediğinde kendini değerli hissediyorsun.",
   "start": 108.399,
   "end": 110.922
  },
  {
   "i": 33,
   "text": "Biri hayal kırıklığına uğramış göründüğünde, sanki sende bir sorun varmış gibi hissediyorsun.",
   "start": 111.342,
   "end": 116.312
  },
  {
   "i": 34,
   "text": "O yüzden daha çok çabalıyorsun.",
   "start": 116.732,
   "end": 118.489
  },
  {
   "i": 35,
   "text": "Kendini açıklıyorsun.",
   "start": 118.909,
   "end": 120.083
  },
  {
   "i": 36,
   "text": "Hiçbir yanlış yapmadığın halde özür diliyorsun.",
   "start": 120.503,
   "end": 123.199
  },
  {
   "i": 37,
   "text": "Belki de senin sorumluluğunda bile olmayan duyguları onarmaya çalışıyorsun.",
   "start": 123.619,
   "end": 127.536
  },
  {
   "i": 38,
   "text": "Ama öz değerini bu şekilde inşa etmenin bir sorunu var.",
   "start": 128.356,
   "end": 131.326
  },
  {
   "i": 39,
   "text": "Başkalarının tepkileri senin kontrolünde değil.",
   "start": 131.746,
   "end": 134.149
  },
  {
   "i": 40,
   "text": "İnsanlar seni yanlış anlayabilir.",
   "start": 134.569,
   "end": 136.56
  },
  {
   "i": 41,
   "text": "Kötü bir gün geçiriyor olabilirler.",
   "start": 136.98,
   "end": 138.861
  },
  {
   "i": 42,
   "text": "Hiçbir yanlış yapmamış olsan bile seninle aynı fikirde olmayabilirler.",
   "start": 139.281,
   "end": 143.31
  },
  {
   "i": 43,
   "text": "Ve her olumsuz tepki karakterin hakkında verilmiş bir hüküm gibi hissettiriyorsa, kendini hiçbir zaman tam olarak güvende hissetmeyeceksin.",
   "start": 143.73,
   "end": 150.959
  },
  {
   "i": 44,
   "text": "Peşinden koşacak hep başka bir ışık olacak.",
   "start": 151.379,
   "end": 153.776
  },
  {
   "i": 45,
   "text": "Ve sen bu ışıkların peşinden koşmakla meşgulken, başka bir şey olmaya başlıyor.",
   "start": 154.196,
   "end": 158.639
  },
  {
   "i": 46,
   "text": "Kendi planlarını erteliyorsun.",
   "start": 159.659,
   "end": 161.373
  },
  {
   "i": 47,
   "text": "Yorgunluğunu görmezden geliyorsun.",
   "start": 161.793,
   "end": 163.724
  },
  {
   "i": 48,
   "text": "Fikirlerini saklıyorsun.",
   "start": 164.144,
   "end": 165.482
  },
  {
   "i": 49,
   "text": "Bazen artık ne istediğini bile bilmiyorsun.",
   "start": 165.902,
   "end": 168.291
  },
  {
   "i": 50,
   "text": "Herkesin neye ihtiyacı olduğunu sormaya o kadar alışıyorsun ki, kendi ihtiyacını sormak tuhaf biçimde rahatsız edici geliyor.",
   "start": 168.711,
   "end": 175.346
  },
  {
   "i": 51,
   "text": "Sonunda kendini seçtiğinde suçlu bile hissedebilirsin.",
   "start": 175.766,
   "end": 178.612
  },
  {
   "i": 52,
   "text": "Ve bu suçluluk kafa karıştırıcı olabilir.",
   "start": 179.032,
   "end": 181.21
  },
  {
   "i": 53,
   "text": "Bunu, yanlış bir şey yaptığının kanıtı olarak yorumlayabilirsin.",
   "start": 181.63,
   "end": 184.873
  },
  {
   "i": 54,
   "text": "Ama suçluluk bir duygudur, her zaman bir hüküm değildir.",
   "start": 185.693,
   "end": 188.704
  },
  {
   "i": 55,
   "text": "Bazen değerlerini ihlal ettiğin için ortaya çıkar.",
   "start": 189.124,
   "end": 191.831
  },
  {
   "i": 56,
   "text": "Bazen de alışık olmadığın bir şey yaptığın için.",
   "start": 192.251,
   "end": 194.745
  },
  {
   "i": 57,
   "text": "Yıllarca hayal kırıklığından kaçındıysan, makul bir sınır koymak, doğal gelmeye başlamadan önce yanlış gelebilir.",
   "start": 195.165,
   "end": 201.413
  },
  {
   "i": 58,
   "text": "Şimdi farklı bir an hayal et.",
   "start": 203.133,
   "end": 204.81
  },
  {
   "i": 59,
   "text": "Biri senden bir iyilik daha istiyor.",
   "start": 205.23,
   "end": 207.194
  },
  {
   "i": 60,
   "text": "Yorgunsun.",
   "start": 207.614,
   "end": 208.295
  },
  {
   "i": 61,
   "text": "Enerjin yok.",
   "start": 208.715,
   "end": 209.538
  },
  {
   "i": 62,
   "text": "Alıştığın cevap ağzına geliyor.",
   "start": 209.958,
   "end": 211.688
  },
  {
   "i": 63,
   "text": "Tabii.",
   "start": 212.108,
   "end": 212.47
  },
  {
   "i": 64,
   "text": "Ama bu sefer duraksıyorsun.",
   "start": 213.79,
   "end": 215.402
  },
  {
   "i": 65,
   "text": "Göğsündeki gerginliği fark ediyorsun.",
   "start": 215.822,
   "end": 217.934
  },
  {
   "i": 66,
   "text": "Onların hayal kırıklığına uğrayabileceği korkusunu fark ediyorsun.",
   "start": 218.354,
   "end": 221.676
  },
  {
   "i": 67,
   "text": "Ve o duyguyu hemen yok etmeye çalışmak yerine, orada olmasına izin veriyorsun.",
   "start": 222.096,
   "end": 226.553
  },
  {
   "i": 68,
   "text": "Sonra şunu söylüyorsun:",
   "start": 226.973,
   "end": 228.434
  },
  {
   "i": 69,
   "text": "‘Üzgünüm, bugün yapamam.’",
   "start": 229.554,
   "end": 231.053
  },
  {
   "i": 70,
   "text": "Karşındaki hayal kırıklığına uğramış görünüyor.",
   "start": 232.873,
   "end": 235.36
  },
  {
   "i": 71,
   "text": "Ve bir an için, söylediğini geri almak istiyorsun.",
   "start": 235.78,
   "end": 238.1
  },
  {
   "i": 72,
   "text": "Daha fazla açıklamak istiyorsun.",
   "start": 238.52,
   "end": 240.349
  },
  {
   "i": 73,
   "text": "Başka bir iyilik teklif etmek istiyorsun.",
   "start": 240.769,
   "end": 242.94
  },
  {
   "i": 74,
   "text": "Hâlâ senden hoşlandıklarından kesinlikle emin olmak istiyorsun.",
   "start": 243.36,
   "end": 247.05
  },
  {
   "i": 75,
   "text": "Ama bekliyorsun.",
   "start": 248.37,
   "end": 249.295
  },
  {
   "i": 76,
   "text": "Nefes alıyorsun.",
   "start": 250.215,
   "end": 251.142
  },
  {
   "i": 77,
   "text": "O anın var olmasına, onu bir acil durummuş gibi görmeden izin veriyorsun.",
   "start": 253.162,
   "end": 257.368
  },
  {
   "i": 78,
   "text": "Belki karşındaki anlar.",
   "start": 257.788,
   "end": 259.26
  },
  {
   "i": 79,
   "text": "Belki anlamaz.",
   "start": 259.68,
   "end": 260.684
  },
  {
   "i": 80,
   "text": "Her iki durumda da önemli bir şey öğrendin.",
   "start": 261.104,
   "end": 263.13
  },
  {
   "i": 81,
   "text": "Rahatsızlık, otomatik olarak tehlike demek değildir.",
   "start": 264.45,
   "end": 267.267
  },
  {
   "i": 82,
   "text": "Ve bir başkasının hayal kırıklığı, otomatik olarak senin yanlış bir şey yaptığın anlamına gelmez.",
   "start": 267.687,
   "end": 272.809
  },
  {
   "i": 83,
   "text": "Bu, insanlara yardım etmeyi bırakman gerektiği anlamına gelmez.",
   "start": 274.329,
   "end": 277.89
  },
  {
   "i": 84,
   "text": "Her isteğin bir hayır hak ettiği anlamına da gelmez.",
   "start": 278.31,
   "end": 281.052
  },
  {
   "i": 85,
   "text": "Ve kesinlikle önemsemeyi bırakman gerektiği anlamına gelmez.",
   "start": 281.472,
   "end": 284.792
  },
  {
   "i": 86,
   "text": "Bu, nezaketinin korkuyla yönlendirilen bir refleks yerine bir seçim olabileceği anlamına gelir.",
   "start": 285.212,
   "end": 290.226
  },
  {
   "i": 87,
   "text": "Gerçekten istediğin için yardım edebilirsin.",
   "start": 290.646,
   "end": 293.022
  },
  {
   "i": 88,
   "text": "Her sorunu çözmekten sorumlu olmadan dinleyebilirsin.",
   "start": 293.442,
   "end": 296.343
  },
  {
   "i": 89,
   "text": "Birinin duygularını önemseyebilirsin, ama o duyguların verdiğin her kararı belirlemesine izin vermek zorunda değilsin.",
   "start": 296.763,
   "end": 302.959
  },
  {
   "i": 90,
   "text": "Ve bir hata yaptığında, kendini kötü biri haline getirmeden sorumluluğunu alabilirsin.",
   "start": 303.379,
   "end": 307.848
  },
  {
   "i": 91,
   "text": "Bir dahaki sefere hemen kabul etme isteği hissettiğinde, kendine bir an tanı.",
   "start": 309.168,
   "end": 313.297
  },
  {
   "i": 92,
   "text": "Kendine sor:",
   "start": 313.717,
   "end": 314.418
  },
  {
   "i": 93,
   "text": "Bu kişinin bana kızmayacağını bilseydim, gerçekte ne seçerdim?",
   "start": 314.838,
   "end": 318.276
  },
  {
   "i": 94,
   "text": "Hayatını bugün baştan değiştirmek zorunda değilsin.",
   "start": 319.096,
   "end": 321.8
  },
  {
   "i": 95,
   "text": "Tek bir dürüst cevapla başlayabilirsin.",
   "start": 322.22,
   "end": 324.284
  },
  {
   "i": 96,
   "text": "Makul bir sınırla.",
   "start": 324.704,
   "end": 325.785
  },
  {
   "i": 97,
   "text": "Başkasının duygularını yaşamasına, kendi ihtiyaçlarını terk etmeden izin verdiğin tek bir anla.",
   "start": 326.205,
   "end": 331.332
  },
  {
   "i": 98,
   "text": "Çünkü amaç, hiç kimseyi hayal kırıklığına uğratmayan biri olmak değil.",
   "start": 332.652,
   "end": 336.48
  },
  {
   "i": 99,
   "text": "Amaç, sırf sevilmek için kendini terk etmeyen biri olmak.",
   "start": 336.9,
   "end": 340.093
  }
 ],
