{
  "name": "week-ride",
  "version": "1.0.0",
  "description": "Vertical 9:16 minimalist canvas animation: a stick figure cycling across a week-long terrain (1080x1920, 60 fps).",
  "private": true,
  "scripts": {
    "preview": "node preview.js",
    "render": "node render.js",
    "render:test": "node render.js --frames 0-180 --out test.mp4",
    "stills": "node render.js --png stills --times 0.5,3,6,8.6,10,11.6,12.2,13"
  },
  "dependencies": {
    "canvas": "^3.1.0"
  },
  "engines": { "node": ">=18" }
}
