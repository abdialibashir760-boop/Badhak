{
  "name": "chile-rescue-video",
  "version": "1.0.0",
  "private": true,
  "description": "9:16 animated true-story rescue Shorts (San Jos\u00e9 mine, Apollo 13), built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "preview": "remotion studio",
    "audio": "python3 -I scripts/make_audio.py",
    "render": "remotion render src/index.ts Apollo13 out/apollo13.mp4",
    "render:san-jose": "remotion render src/index.ts SanJose out/san-jose-part1.mp4",
    "still": "remotion still src/index.ts Apollo13 out/still.png --frame=1500",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.538",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.538"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  }
}
